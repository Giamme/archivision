{
  "changelog": "CHANGELOG.md",
  "heading_format": "## [{version}] - {date}",
  "group_by_type": true,
  "tag_format": "v{version}",
  "versioning": {
    "preset": "two-part",
    "format": "{major}.{minor}",
    "bump_rules": {
      "breaking": "major",
      "added": "minor",
      "default": "minor"
    },
    "zero_major": true
  },
  "version_files": [
    {
      "path": "package.json",
      "format": "{major}.{minor}.0"
    }
  ],
  "whats_new_path": null,
  "skip_types": [
    "build",
    "chore",
    "ci",
    "docs",
    "refactor",
    "style",
    "test",
    "tests"
  ],
  "ignore": [
    "^Merge (pull request|branch|remote-tracking branch) ",
    "^chore\\(release\\)",
    "^Release v?\\d+\\.\\d+",
    "^v?\\d+(\\.\\d+)+\\S*$",
    "\\[(skip|no) changelog\\]",
    "^archivision \\d+\\.\\d+$"
  ],
  "normalize": [],
  "baseline": "v0.3"
}
